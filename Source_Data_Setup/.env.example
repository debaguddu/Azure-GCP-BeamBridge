# ==============================================================
# Database Configuration Template
# Place this file as .env in project root or Source_Data_Setup/
# ==============================================================

# --------------------------------------------------------------
# SQL Server Database Configuration
# --------------------------------------------------------------
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=ADFPracticeNihar2001
DB_TRUSTED_CONNECTION=no
DB_USER=sa
DB_PASSWORD=YourPasswordHere
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=yes

# ETL Batch Options
BATCH_SIZE=50000
DROP_EXISTING=yes
ADD_CONSTRAINTS=yes

# --------------------------------------------------------------
# PostgreSQL Database Configuration
# --------------------------------------------------------------
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=postgres
PG_USER=postgres
PG_PASSWORD=your_postgres_password
PG_SCHEMA=public
PG_SSLMODE=prefer

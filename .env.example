# ==============================================================
# SQL Server Database Configuration
# ==============================================================

# Server host: e.g. localhost, 127.0.0.1, or DESKTOP-NAME\SQLEXPRESS, or my-server.database.windows.net
DB_SERVER=localhost

# Port: standard port is 1433 (leave empty if using named instances like .\SQLEXPRESS)
DB_PORT=1433

# Database name (must exist on the SQL Server)
DB_NAME=YourDatabaseName

# Authentication Mode:
# Set to 'yes' for Windows Authentication (integrated security)
# Set to 'no' for SQL Server Authentication (username + password)
DB_TRUSTED_CONNECTION=no

# SQL Server credentials (used when DB_TRUSTED_CONNECTION=no)
DB_USER=sa
DB_PASSWORD=YourPasswordHere

# ODBC Driver name
DB_DRIVER=ODBC Driver 18 for SQL Server

# Trust server certificate (required 'yes' for self-signed certificates in ODBC 18)
DB_TRUST_SERVER_CERTIFICATE=yes

# Loading options
BATCH_SIZE=50000
DROP_EXISTING=yes
ADD_CONSTRAINTS=yes

# ==============================================================
# PostgreSQL Database Configuration
# ==============================================================

# Server host: e.g. localhost, 127.0.0.1, or remote host
PG_HOST=localhost

# Standard PostgreSQL port is 5432
PG_PORT=5432

# Target database name (e.g. postgres or your application db)
PG_DATABASE=postgres

# PostgreSQL credentials
PG_USER=postgres
PG_PASSWORD=YourPostgresPasswordHere

# Optional settings: schema and SSL mode ('disable', 'allow', 'prefer', 'require')
PG_SCHEMA=public
PG_SSLMODE=prefer


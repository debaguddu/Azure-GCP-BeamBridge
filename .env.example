# ==============================================================================
# GCP BeamBridge - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and replace placeholder values with your environment details:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Runtime
# ------------------------------------------------------------------------------
ENVIRONMENT=dev
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Google Cloud Platform (GCP) Project & Authentication
# ------------------------------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-south1
GOOGLE_APPLICATION_CREDENTIALS=credentials/gcp-service-account-key.json
GCP_SERVICE_ACCOUNT_EMAIL=your-sa@your-gcp-project-id.iam.gserviceaccount.com

# ------------------------------------------------------------------------------
# 3. Google Cloud Storage (GCS) Landing Zone & Dataflow Buckets
# ------------------------------------------------------------------------------
GCS_LANDING_BUCKET=your-gcs-landing-bucket
GCS_BASE_PATH=retail
GCS_STORAGE_CLASS=STANDARD
GCS_TEMP_LOCATION=gs://your-gcs-landing-bucket/temp
GCS_STAGING_LOCATION=gs://your-gcs-landing-bucket/staging
GCS_ARCHIVE_BUCKET=your-archive-bucket
GCS_SCHEMAS_BUCKET=your-schemas-bucket

# ------------------------------------------------------------------------------
# 4. Target Analytical Store (BigQuery)
# ------------------------------------------------------------------------------
BIGQUERY_DATASET=retail_dw
BIGQUERY_DLQ_DATASET=retail_dlq
BIGQUERY_BRONZE_DATASET=bronze_staging
BIGQUERY_SILVER_DATASET=silver_cdm
BIGQUERY_GOLD_DATASET=gold_analytics
BIGQUERY_SERVING_DATASET=serving_views

# ------------------------------------------------------------------------------
# 5. Cloud Pub/Sub Streaming Topics
# ------------------------------------------------------------------------------
PUBSUB_ORDERS_INGEST_TOPIC=projects/your-gcp-project-id/topics/orders-stream-in
PUBSUB_DLQ_ALERTS_TOPIC=projects/your-gcp-project-id/topics/orders-dlq-alerts

# ------------------------------------------------------------------------------
# 6. Source Relational Databases (Azure SQL Server)
# ------------------------------------------------------------------------------
AZURE_SQL_SERVER=your-azure-sql-server.database.windows.net
AZURE_SQL_PORT=1433
AZURE_SQL_DATABASE=your_database_name
AZURE_SQL_USER=your_username
AZURE_SQL_PASSWORD=your_password
AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server
AZURE_SQL_TRUST_SERVER_CERTIFICATE=yes
BATCH_SIZE=50000

# ------------------------------------------------------------------------------
# 7. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=postgres
PG_USER=postgres
PG_PASSWORD=your_pg_password
PG_SCHEMA=public
PG_SSLMODE=prefer

# ------------------------------------------------------------------------------
# 8. GCP Secret Manager & KMS
# ------------------------------------------------------------------------------
GCP_SECRET_AZURE_SQL=projects/your-gcp-project-id/secrets/azure-sql-connection/versions/latest
GCP_KMS_KEY_ID=projects/your-gcp-project-id/locations/asia-south1/keyRings/your-keyring/cryptoKeys/your-key
